<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DataSenderPlusProject.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تنظیمات | SmartDataSync" Width="780" Height="720" MinWidth="680" MinHeight="520" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12" FlowDirection="RightToLeft" Background="#F2F5F9" Foreground="#1D334B">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#087F8C" />
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E1E8EF" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" /><Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#486079" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#74869A" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#36516B" />
            <Setter Property="BorderBrush" Value="#D7E1EA" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="17,9" /><Setter Property="MinHeight" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-1" Duration="0:0:0.12" />
                            </Storyboard></BeginStoryboard></EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.12" />
                            </Storyboard></BeginStoryboard></EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#087F8C" />
                                <Setter TargetName="Surface" Property="Effect"><Setter.Value><DropShadowEffect Color="#245164" ShadowDepth="2" BlurRadius="10" Opacity="0.16" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#087F8C" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78" /><Setter TargetName="Surface" Property="Effect" Value="{x:Null}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#087F8C" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#087F8C" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC" /><Setter Property="Foreground" Value="#20364C" />
            <Setter Property="BorderBrush" Value="#DCE5ED" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" /><Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,0,10" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#087F8C" /><Setter Property="SelectionBrush" Value="#A9DDE2" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#A4BACB" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#087F8C" /><Setter TargetName="InputBorder" Property="Background" Value="White" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#F8FAFC" /><Setter Property="BorderBrush" Value="#DCE5ED" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="11,8" />
            <Setter Property="MinHeight" Value="38" /><Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CaretBrush" Value="#087F8C" /><Setter Property="SelectionBrush" Value="#A9DDE2" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#A4BACB" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#087F8C" /><Setter TargetName="InputBorder" Property="Background" Value="White" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EEF6F7" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#DFF1F2" /><Setter Property="Foreground" Value="#086674" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38" /><Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#DCE5ED" /><Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" />
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Grid IsHitTestVisible="False" Margin="11,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#6A8298" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="#DCE5ED" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="220" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#A4BACB" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#087F8C" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#526B81" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="CheckSurface" Width="17" Height="17" CornerRadius="4" BorderBrush="#C4D3DF" BorderThickness="1" Background="White" VerticalAlignment="Center">
                        <Path x:Name="CheckMark" Data="M 3 8 L 6 11 L 12 4" Stroke="White" StrokeThickness="1.7" Visibility="Collapsed" />
                    </Border>
                    <ContentPresenter VerticalAlignment="Center" Margin="7,0,0,0" RecognizesAccessKey="True" />
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#087F8C" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#087F8C" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#087F8C" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="3" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabSurface" Background="Transparent" CornerRadius="8" Padding="16,12" BorderThickness="1" BorderBrush="Transparent">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E5EDF3" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="White" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="#D8E6EB" /><Setter Property="Foreground" Value="#087F8C" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="#E8EEF4" CornerRadius="11" Padding="3">
                        <UniformGrid Rows="1" IsItemsHost="True" />
                    </Border>
                    <ContentPresenter Grid.Row="2" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="#172F47" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="#28465D" CornerRadius="12" Width="42" Height="42" VerticalAlignment="Center">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#A7E1E4" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="تنظیمات برنامه" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="مدیریت اتصال دیتابیس و فایل‌های ارسالی" Foreground="#AEC2D2" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="SmartDataSync" Foreground="#A7E1E4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" FlowDirection="LeftToRight" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="22,18,22,0">
            <Border x:Name="AccessPanel" Style="{StaticResource SectionCard}" MaxWidth="430" VerticalAlignment="Center" Padding="32">
                <StackPanel>
                    <Border Width="56" Height="56" Background="#E7F4F5" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#087F8C" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ورود به تنظیمات" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="برای مدیریت تنظیمات، رمز دسترسی را وارد کنید." Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,0,0,24" />
                    <TextBlock Text="رمز دسترسی" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="AccessPassword" FlowDirection="LeftToRight" />
                    <Button x:Name="UnlockButton" Content="ورود به تنظیمات" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Unlock_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
                    <TabItem Header="تنظیمات دیتابیس">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,4,0">
                                    <Border Style="{StaticResource SectionCard}">
                                        <StackPanel>
                                            <TextBlock Text="مشخصات اتصال" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="آدرس سرور" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ServerInput" FlowDirection="LeftToRight" ToolTip="Server یا Server\Instance" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="نام دیتابیس" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DatabaseInput" FlowDirection="LeftToRight" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="نام کاربری SQL Server" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UserInput" FlowDirection="LeftToRight" /></StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="ShowPassword" Content="نمایش رمز" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" Grid.Column="1" />
                                                <TextBlock Text="رمز دیتابیس" Style="{StaticResource FieldLabel}" Margin="0" />
                                            </Grid>
                                            <PasswordBox x:Name="DatabasePassword" FlowDirection="LeftToRight" Margin="0" />
                                            <TextBox x:Name="VisiblePassword" Visibility="Collapsed" FlowDirection="LeftToRight" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SectionCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="مهلت اجرای پروسیجر" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <TextBlock Text="بر حسب ثانیه؛ صفر یعنی انتظار نامحدود." Style="{StaticResource Hint}" />
                                            </StackPanel>
                                            <TextBox x:Name="TimeoutInput" Grid.Column="1" FlowDirection="LeftToRight" Margin="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="رمز دیتابیس رمزگذاری می‌شود و با همین حساب ویندوز قابل بازیابی است." Style="{StaticResource Hint}" Margin="6,0,6,8" />
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="TestDatabaseButton" Content="تست ارتباط دیتابیس" Click="TestDatabase_Click" MinWidth="170"/>
                                <Button x:Name="SaveButton" Grid.Column="2" Content="ذخیره تنظیمات دیتابیس" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="185"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="تنظیمات ارسال">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource SectionCard}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="انتخاب فایل ارسالی" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="SenderSelection" DisplayMemberPath="DisplayName" SelectionChanged="SenderSelection_Changed" Margin="0" />
                                    </StackPanel>
                                    <Button x:Name="ReloadSenderButton" Grid.Column="2" Content="بازخوانی" Click="ReloadSender_Click" VerticalAlignment="Bottom" ToolTip="خواندن آخرین تنظیمات از دیتابیس" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid x:Name="SenderFields" IsEnabled="False" Margin="0,0,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="فایل خروجی و زمان‌بندی" Style="{StaticResource SectionTitle}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="نام فایل، بدون پسوند" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ExportFileName" FlowDirection="LeftToRight" /></StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="فرمت خروجی" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox x:Name="OutputTypeInput" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="JSON" Tag="1" /><ComboBoxItem Content="CSV" Tag="2" />
                                                        <ComboBoxItem Content="XML" Tag="3" /><ComboBoxItem Content="Excel (.xlsx)" Tag="4" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="پوشهٔ ذخیرهٔ فایل" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Content="انتخاب پوشه" Click="BrowseFolder_Click" Margin="0,0,8,0" VerticalAlignment="Top" />
                                                <TextBox x:Name="ExportFolder" FlowDirection="LeftToRight" Margin="0" />
                                            </DockPanel>
                                            <TextBlock Text="فایل در زیرپوشهٔ ExportFile ساخته می‌شود. خالی بگذارید تا مسیر برنامه استفاده شود." Style="{StaticResource Hint}" Margin="0,6,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="بازهٔ ارسال، به دقیقه" Style="{StaticResource FieldLabel}" /><TextBox x:Name="IntervalInput" FlowDirection="LeftToRight" Margin="0" /></StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="روش ارسال" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox x:Name="SendModeInput" SelectedValuePath="Tag" SelectionChanged="SendMode_Changed" Margin="0">
                                                        <ComboBoxItem Content="۱ · ساخت فایل و آپلود FTP" Tag="1"/>
                                                        <ComboBoxItem Content="۲ · فقط ذخیرهٔ لوکال" Tag="2"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SectionCard}" Grid.Column="2" Margin="0,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="اتصال به سرور FTP" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="آدرس پوشهٔ سرور" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="FtpAddress" FlowDirection="LeftToRight" ToolTip="ftp://server/folder" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}" /><TextBox x:Name="FtpUser" FlowDirection="LeftToRight" Margin="0" /></StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="ShowFtpPassword" Content="نمایش" Checked="ShowFtpPassword_Changed" Unchecked="ShowFtpPassword_Changed" Grid.Column="1" />
                                                        <TextBlock Text="رمز FTP" Style="{StaticResource FieldLabel}" Margin="0" />
                                                    </Grid>
                                                    <PasswordBox x:Name="FtpPassword" FlowDirection="LeftToRight" Margin="0" />
                                                    <TextBox x:Name="FtpVisiblePassword" Visibility="Collapsed" FlowDirection="LeftToRight" Margin="0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="TestFtpButton" Content="تست ارسال FTP" Click="TestFtp_Click" IsEnabled="False" MinWidth="170" ToolTipService.ShowOnDisabled="True" ToolTip="تست FTP فقط در حالت روش ارسال ۱ فعال است؛ حالت ۲ فقط فایل لوکال می‌سازد."/>
                                <Button x:Name="SaveSenderButton" Grid.Column="2" Content="ذخیره تنظیمات این فایل" Style="{StaticResource PrimaryButton}" Click="SaveSender_Click" IsEnabled="False" MinWidth="185"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#DEE7EF" BorderThickness="0,1,0,0" Padding="22,12" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="بستن" IsCancel="True" MinWidth="85" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#62788D" VerticalAlignment="Center" Margin="0,0,18,0" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
