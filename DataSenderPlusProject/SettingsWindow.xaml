<Window x:Class="DataSenderPlusProject.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات دیتابیس" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="4"/></Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="تنظیمات اتصال دیتابیس" FontSize="20" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,18"/>
        <StackPanel x:Name="AccessPanel">
            <TextBlock Text="برای ورود، رمز تنظیمات را وارد کنید."/>
            <PasswordBox x:Name="AccessPassword" FlowDirection="LeftToRight"/>
            <Button x:Name="UnlockButton" Content="ورود به تنظیمات" IsDefault="True" Click="Unlock_Click" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
            <TextBlock Text="آدرس سرور (Server یا Server\Instance)"/>
            <TextBox x:Name="ServerInput" FlowDirection="LeftToRight"/>
            <TextBlock Text="نام دیتابیس"/>
            <TextBox x:Name="DatabaseInput" FlowDirection="LeftToRight"/>
            <TextBlock Text="نام کاربری SQL Server"/>
            <TextBox x:Name="UserInput" FlowDirection="LeftToRight"/>
            <TextBlock Text="رمز دیتابیس"/>
            <PasswordBox x:Name="DatabasePassword" FlowDirection="LeftToRight"/>
            <TextBox x:Name="VisiblePassword" Visibility="Collapsed" FlowDirection="LeftToRight"/>
            <CheckBox x:Name="ShowPassword" Content="نمایش رمز دیتابیس" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" Margin="0,0,0,12"/>
            <TextBlock Text="مهلت اجرای پروسیجر (ثانیه؛ صفر یعنی نامحدود)"/>
            <TextBox x:Name="TimeoutInput" FlowDirection="LeftToRight"/>
            <TextBlock Text="رمز ذخیره‌شده فقط با همین حساب ویندوز قابل بازیابی است." TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SaveButton" Content="ذخیره" Click="Save_Click"/>
                <Button Content="بستن" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#B42318" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
