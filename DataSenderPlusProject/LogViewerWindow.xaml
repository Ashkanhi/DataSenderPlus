<Window x:Class="DataSenderPlusProject.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="۱۰ لاگ آخر برنامه" Width="900" Height="560"
        MinWidth="650" MinHeight="400" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="#F5F7FA" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="RefreshButton" DockPanel.Dock="Left" Content="به‌روزرسانی"
                    Padding="16,6" Click="Refresh_Click"/>
            <CheckBox x:Name="ErrorsOnly" DockPanel.Dock="Right" Content="فقط خطاها"
                      VerticalAlignment="Center" Margin="8,0" Checked="Refresh_Click" Unchecked="Refresh_Click"/>
            <TextBlock x:Name="StatusText" Text="در حال خواندن لاگ‌ها…"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0"/>
        </DockPanel>
        <DataGrid x:Name="LogGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                  FlowDirection="LeftToRight" HeadersVisibility="Column" RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="زمان" Binding="{Binding Timestamp}" Width="155"/>
                <DataGridTextColumn Header="سطح" Binding="{Binding Level}" Width="85"/>
                <DataGridTextColumn Header="پیام" Binding="{Binding Summary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="متن کامل لاگ انتخاب‌شده (قابل کپی)" Margin="0,12,0,6"/>
        <TextBox Grid.Row="3" Text="{Binding SelectedItem.Message, ElementName=LogGrid, Mode=OneWay}"
                 IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
    </Grid>
</Window>
